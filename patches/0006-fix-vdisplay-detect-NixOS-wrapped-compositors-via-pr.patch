+/// True when `/proc/<pid>/comm` names the binary `name`.
+///
+/// On distro packages this is usually an exact match (`kwin_wayland`). On NixOS the real
+/// executable is rewritten to `.<name>-wrapped`, and the kernel only stores the first 15 bytes of
+/// that basename in `comm` (`TASK_COMM_LEN`), so a live KWin shows up as `.kwin_wayland-w` rather
+/// than `kwin_wayland`. A leading `.` is stripped; anything that then equals `name` or continues
+/// with `-` (the wrap/truncation suffix) counts.
+///
+/// The `_wrapper` helper process is deliberately not matched: its basename is
+/// `.<name>_wrapper-wrapped` → e.g. `.kwin_wayland_w`, which continues with `_` rather than `-`.
+#[cfg(target_os = "linux")]
+pub(crate) fn comm_is(comm: &str, name: &str) -> bool {
+    let c = comm.trim();
+    if c == name {
+        return true;
+    }
+    let c = c.strip_prefix('.').unwrap_or(c);
+    c == name || c.starts_with(&format!("{name}-"))
+}
+
+/// Map a `/proc/<pid>/comm` string to `(kind, priority)` for the live-session probe, or `None`
+/// when it is not a compositor we drive. Priority lets a real desktop beat a leftover gamescope.
+#[cfg(target_os = "linux")]
+fn classify_compositor_comm(comm: &str) -> Option<(ActiveKind, u8)> {
+    if comm_is(comm, "gamescope") || comm_is(comm, "gamescope-wl") {
+        return Some((ActiveKind::Gaming, 1));
+    }
+    if comm_is(comm, "kwin_wayland") {
+        return Some((ActiveKind::DesktopKde, 4));
+    }
+    if comm_is(comm, "gnome-shell") {
+        return Some((ActiveKind::DesktopGnome, 4));
+    }
+    // Hyprland is its own backend (hyprctl + xdph) — split it out of the sway/river
+    // wlroots-proper family (design/hyprland-support.md D1).
+    if comm_is(comm, "Hyprland") || comm_is(comm, "hyprland") {
+        return Some((ActiveKind::DesktopHyprland, 4));
+    }
+    if comm_is(comm, "sway") || comm_is(comm, "river") {
+        return Some((ActiveKind::DesktopWlroots, 4));
+    }
+    None
+}
