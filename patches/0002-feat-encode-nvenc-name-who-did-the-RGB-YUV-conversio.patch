+# Colour signalling overrides — DIAGNOSTIC. Unset (the default) leaves the derived values, so
+# leaving these commented out is exactly what every host did before they existed.
+#
+# The stream declares which matrix and swing turned RGB into YUV, and a decoder inverts with
+# whatever it is told. That declaration is only trustworthy when one of our own shaders did the
+# conversion (the NV12 / P010 paths). On a packed-RGB input NVENC converts internally, against a
+# matrix the SDK does not document and does not take from these fields — so there the declaration
+# is an assumption. Symptom of a wrong one: a picture that streams, paces and decodes perfectly
+# but is uniformly tinted, most visibly on skin tones and neutral greys.
+#
+# Set these only to establish what a specific encoder actually produced, then report it.
+#PUNKTFUNK_VUI_MATRIX=bt709         # rgb|bt709|unspecified|fcc|bt470bg(=bt601)|smpte170m|
+                                    # smpte240m|ycgco|bt2020ncl|bt2020cl|smpte2085
+#PUNKTFUNK_VUI_FULL_RANGE=0         # 0/limited (studio swing) | 1/full (PC swing)
+
