+    #[test]
+    fn comm_is_matches_exact_and_nix_wrapped_truncations() {
+        // Distro package: bare basename.
+        assert!(comm_is("kwin_wayland", "kwin_wayland"));
+        assert!(comm_is("kwin_wayland\n", "kwin_wayland"));
+        // NixOS: `.<name>-wrapped` truncated to TASK_COMM_LEN (15).
+        assert!(comm_is(".kwin_wayland-w", "kwin_wayland"));
+        assert!(comm_is(".gamescope-wrap", "gamescope"));
+        assert!(comm_is(".gnome-shell-wr", "gnome-shell"));
+        assert!(comm_is(".Hyprland-wrapp", "Hyprland"));
+        // Full untruncated wrap form (short names fit in 15).
+        assert!(comm_is(".sway-wrapped", "sway"));
+        // Negatives: unrelated, and the Nix `_wrapper` helper (underscore, not hyphen).
+        assert!(!comm_is("kwin_x11", "kwin_wayland"));
+        assert!(!comm_is(".kwin_wayland_w", "kwin_wayland"));
+        assert!(!comm_is("not-kwin", "kwin_wayland"));
+    }
+
+    #[test]
